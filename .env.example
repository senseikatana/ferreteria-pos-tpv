# Environment Configuration for Universal POS System

# InsForge PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Or from InsForge CLI: npx @insforge/cli secrets get DATABASE_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_universal?schema=public"

# JWT Authentication Secret
JWT_SECRET="super-secret-jwt-pos-universal-key-replace-in-production"

# KatanaKit CDN Endpoint
KATANAKIT_CDN_URL="https://esm.sh/katanakit-js@2.14.1"

# Application Settings
APP_NAME="Universal POS Core"
APP_CURRENCY="$"
PORT=3000
